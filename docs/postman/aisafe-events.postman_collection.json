                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"durable, one consumer (the replica)\", () => { pm.expect(pm.response.json().durable).to.be.true; pm.expect(pm.response.json().consumers).to.eql(1); });"
