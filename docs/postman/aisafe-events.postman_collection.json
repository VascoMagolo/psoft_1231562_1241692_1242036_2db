        },
        {
          "name": "Exchange airports-routes.events (topic)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbit_api}}/exchanges/%2F/airports-routes.events",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbit_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbit_password}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"topic, durable\", () => { pm.expect(pm.response.json().type).to.eql(\"topic\"); pm.expect(pm.response.json().durable).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Read-model queue of airports-routes-0, with its consumer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbit_api}}/queues/%2F/airports-routes.read-model.{{ar_node_0}}",
            "auth": {
