                  "pm.test(\"from the read model (CQRS query side)\", () => pm.expect(pm.response.headers.get(\"X-Query-Side\")).to.eql(\"read-model\"));",
                  "const mine = pm.response.json().find(u => u.registrationNumber === pm.environment.get(\"a2_aircraft\"));",
                  "pm.test(\"lists the new aircraft\", () => pm.expect(mine).to.be.an(\"object\"));",
