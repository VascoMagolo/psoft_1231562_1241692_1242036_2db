        {
          "name": "Unicorns on aircraft-maintenance-2 (its own read model)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"answered by aircraft-maintenance-2\", () => pm.expect(pm.response.headers.get(\"X-Node-Id\")).to.eql(\"aircraft-maintenance-2\"));",
                  "pm.test(\"from the read model (CQRS query side)\", () => pm.expect(pm.response.headers.get(\"X-Query-Side\")).to.eql(\"read-model\"));",
                  "const mine = pm.response.json().find(u => u.registrationNumber === pm.environment.get(\"a2_aircraft\"));",
