    {
      "name": "1. The broker: quorum queues, one per replica, and the command queues",
      "description": "Every service declares a quorum queue per replica for its read model and a command queue shared by its replicas, with a dead-letter exchange.",
      "item": [
        {
          "name": "Read-model queue of aircraft-maintenance-0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"quorum queue (replicated on the brokers)\", () => pm.expect(pm.response.json().type).to.eql(\"quorum\"));",
                  "pm.test(\"dead-letter exchange\", () => pm.expect(pm.response.json().arguments[\"x-dead-letter-exchange\"]).to.eql(\"aisafe.dead-letter\"));",
                  "pm.test(\"taken by its replica\", () => pm.expect(pm.response.json().consumers).to.be.at.least(1));"
                ]
