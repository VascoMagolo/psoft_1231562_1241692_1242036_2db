    {
      "name": "2. Command, then event, then the read model (CQRS in aircraft-maintenance)",
      "description": "An aircraft created on aircraft-maintenance-1 (write model: held by -1 and -2) publishes aircraft.created; every replica's read model gets it, also aircraft-maintenance-0, which does not hold it.",
      "item": [
        {
          "name": "Create an aircraft on aircraft-maintenance-1",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const letters = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";",
                  "pm.environment.set(\"a2_aircraft\", \"UN-\" + Array.from({length: 3}, () => letters[Math.floor(Math.random() * 26)]).join(\"\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"answered by aircraft-maintenance-1\", () => pm.expect(pm.response.headers.get(\"X-Node-Id\")).to.eql(\"aircraft-maintenance-1\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{atcc_token}}"
              }
            ],
            "url": "http://{{node}}:{{am_port_1}}/api/aircrafts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"{{a2_aircraft}}\",\n  \"modelName\": \"Airbus A320neo\",\n  \"manufacturingDate\": \"2022-04-01\",\n  \"seatCapacity\": 160,\n  \"range\": 5500.0,\n  \"status\": \"AVAILABLE\",\n  \"features\": [\n    \"WiFi\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "The queue received aircraft.created",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The event leaves right after the commit: give it a moment",
                  "setTimeout(() => {}, 500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const seen = JSON.parse(pm.environment.get(\"events_seen\") || \"[]\");",
                  "pm.response.json().forEach(m => seen.push(Object.assign({routingKey: m.routing_key}, JSON.parse(m.payload))));",
                  "pm.environment.set(\"events_seen\", JSON.stringify(seen));",
                  "const find = (type, key) => seen.filter(e => e.type === type && e.key === key).pop();",
                  "const event = find(\"aircraft.created\", pm.environment.get(\"a2_aircraft\"));",
                  "pm.test(\"aircraft.created received\", () => pm.expect(event, \"aircraft.created\").to.be.an(\"object\"));",
                  "pm.test(\"published by aircraft-maintenance-1\", () => pm.expect(event.nodeId).to.eql(\"aircraft-maintenance-1\"));",
                  "pm.test(\"status AVAILABLE\", () => pm.expect(event.status).to.eql(\"AVAILABLE\"));",
                  "pm.test(\"carries the aircraft (event-carried state)\", () => { pm.expect(event.data.modelName).to.eql(\"Airbus A320neo\"); pm.expect(event.data.seatCapacity).to.eql(160); });",
                  "pm.test(\"stamped (time and replica, for last writer wins)\", () => { pm.expect(event.stamp).to.be.above(0); pm.expect(event.stampNode).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "https://{{rabbit_vip}}/api/queues/%2F/postman.events/get",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "postman",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{postman_password}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 50,\n  \"ackmode\": \"ack_requeue_false\",\n  \"encoding\": \"auto\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "aircraft-maintenance-0 does not hold it: its write model forwards the read (X-Data-Node)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"answered by aircraft-maintenance-0\", () => pm.expect(pm.response.headers.get(\"X-Node-Id\")).to.eql(\"aircraft-maintenance-0\"));",
                  "pm.test(\"data from the replica that holds it (database per instance)\", () => pm.expect(pm.response.headers.get(\"X-Data-Node\")).to.be.oneOf([\"aircraft-maintenance-1\", \"aircraft-maintenance-2\"]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{atcc_token}}"
              }
            ],
            "url": "http://{{node}}:{{am_port_0}}/api/aircrafts/{{a2_aircraft}}"
          }
        },
