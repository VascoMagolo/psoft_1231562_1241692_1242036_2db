@startuml sd_us217
autonumber
skinparam monochrome true
skinparam packageStyle rect
skinparam shadowing false

actor "ATCC / MAINTENANCE_SUPERVISOR" as Actor
participant "MaintenanceController" as Ctrl
participant "SearchMaintenanceRecordsUseCase" as UC
participant "MaintenanceRecordRepository" as Repo
database "Database" as DB

Actor -> Ctrl : GET /api/maintenance/records/search?component={component}
activate Ctrl

Ctrl -> UC : execute(null, null, null, component, page, size)
activate UC

UC -> Repo : findByFilters(null, null, null, component, page, size)
activate Repo
Repo -> DB : SELECT * FROM maintenance_record WHERE component = ?
activate DB
DB --> Repo : matching records
deactivate DB
Repo --> UC : PaginatedResult<MaintenanceRecord>
deactivate Repo

UC --> Ctrl : PaginatedResult<MaintenanceRecordResponse>
deactivate UC

Ctrl --> Actor : 200 OK (PagedModel<MaintenanceRecordResponse>)
deactivate Ctrl

@enduml
