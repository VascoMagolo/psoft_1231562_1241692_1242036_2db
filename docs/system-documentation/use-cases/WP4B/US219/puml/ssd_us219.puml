@startuml ssd_us219
autonumber
skinparam monochrome true
skinparam packageStyle rect
skinparam shadowing false

actor "Maintenance Supervisor" as Actor
participant "System" as Sys

activate Actor
Actor -> Sys : getOngoingMaintenance()
activate Sys
Sys --> Actor : 200 OK (Page<MaintenanceRecordResponse>)
deactivate Sys
deactivate Actor

@enduml
