@startuml sd_us218
autonumber
skinparam monochrome true
skinparam packageStyle rect
skinparam shadowing false

actor "ATCC / MAINTENANCE_SUPERVISOR" as Actor
participant "MaintenanceController" as Ctrl
participant "SearchMaintenanceRecordsUseCase" as UC
participant "MaintenanceRecordRepository" as Repo
database "Database" as DB

Actor -> Ctrl : GET /api/maintenance/records/search\n?registration=?&from=?&to=?&component=?
activate Ctrl

Ctrl -> UC : execute(registration?, from?, to?, component?, page, size)
activate UC

UC -> Repo : findByFilters(registration?, from?, to?, component?, page, size)
activate Repo
Repo -> DB : SELECT * FROM maintenance_record WHERE ...
activate DB
DB --> Repo : matching records
deactivate DB
Repo --> UC : PaginatedResult<MaintenanceRecord>
deactivate Repo

UC --> Ctrl : PaginatedResult<MaintenanceRecordResponse>
deactivate UC

Ctrl --> Actor : 200 OK (PagedModel<MaintenanceRecordResponse>)
deactivate Ctrl

@enduml
